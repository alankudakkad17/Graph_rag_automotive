# ──────────────────────────────────────────────────────────────────────────────
#  Graph RAG Automotive — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# Neo4j (Docker default credentials)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=automotive_rag

# Ollama LLM  (install Ollama from https://ollama.com  →  ollama pull llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3          # alternatives: mistral, gemma2, phi3
OLLAMA_EMBED_MODEL=nomic-embed-text   # or mxbai-embed-large

# HuggingFace local embeddings (used if Ollama embeddings unavailable)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker  (cross-encoder, runs locally – no API key)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ChromaDB  (persistent local directory)
CHROMA_PERSIST_DIR=./data/chroma_db

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Gradio
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
FASTAPI_BASE_URL=http://localhost:8000

# Ingestion
DATA_DIR=./data/pdfs
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Pipeline thresholds
GRAPH_SCORE_THRESHOLD=0.6
VECTOR_SCORE_THRESHOLD=0.5
RERANK_TOP_K=5
RETRIEVAL_TOP_K=10
